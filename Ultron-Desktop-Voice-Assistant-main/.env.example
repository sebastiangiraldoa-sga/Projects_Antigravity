# ============================================================================
# ULTRÓN v3.0 - CONFIGURACIÓN DE ENTORNO (Sebastián Giraldo Acosta)
# ============================================================================

# Nombre del asistente y usuario principal
ULTRON_NAME=Ultrón
ULTRON_USER_NAME=Sebastián
ULTRON_DEFAULT_LANG=es

# Motor STT: "hybrid" (Google STT de alta precisión + fallback offline a faster-whisper), "whisper" o "google"
ULTRON_STT_ENGINE=hybrid
ULTRON_WHISPER_MODEL=base

# Wake-Word (Palabra de activación)
ULTRON_WAKE_WORD_ENABLED=true
ULTRON_WAKE_WORDS=ultron,ultrón,hey ultron,oye ultron,oye ultrón

# Integración con IA Generativa y Visión Multimodal (LLM + VLM)
# Proveedor: "gemini" (Google Gemini 2.0 Flash / 1.5 Flash), "deepseek" o "ollama"
ULTRON_LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-2.0-flash

# Configuración opcional para Ollama local (Texto y Visión Multimodal)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llava

# Motor de Razonamiento DeepSeek-R1 / DeepSeek-V3 (Opcional)
# Proveedor alternativo: ULTRON_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
